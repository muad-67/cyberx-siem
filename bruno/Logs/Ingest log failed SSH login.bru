meta {
  name: Ingest log (failed SSH login)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/logs
  body: json
  auth: none
}

body:json {
  {
    "source_ip": "{{sampleIp}}",
    "log_type": "auth",
    "hostname": "test-vm",
    "message": "Failed password for root from {{sampleIp}} port 22 ssh2"
  }
}

docs {
  Send this 5+ times within 60 seconds to trigger a `brute_force` alert (rule R001).
}
